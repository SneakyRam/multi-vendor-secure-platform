{
  "name": "markethub-backend",
  "version": "1.0.0",
  "description": "MarketHub Secure Multi-Vendor Marketplace",
  "main": "dist/server/server.js",
  "type": "module",
  "scripts": {
    "dev": "node --env-file=.env --import tsx --watch server/server.ts",
    "build": "tsc",
    "start": "node --env-file=.env --import tsx server/server.ts",
    "test": "vitest run",
    "seed": "tsx prisma/seed.ts",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:push": "prisma db push"
  },
  "dependencies": {
    "@prisma/client": "^5.10.0",
    "argon2": "^0.40.1",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "express": "^4.19.2",
    "google-auth-library": "^11.1.0",
    "helmet": "^7.1.0",
    "ioredis": "^5.3.2",
    "neo4j-driver": "^5.17.0",
    "pino": "^8.19.0",
    "uuid": "^9.0.1",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.7",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.11.24",
    "@types/supertest": "^6.0.2",
    "@types/uuid": "^9.0.8",
    "pino-pretty": "^10.3.1",
    "prisma": "^5.10.0",
    "supertest": "^6.3.4",
    "tsx": "^4.7.1",
    "typescript": "^5.3.3",
    "vitest": "^1.3.1"
  }
}
